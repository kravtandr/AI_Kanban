# Copy to .env and fill in. Never commit .env.

# PostgreSQL superuser password for the compose stack (required)
POSTGRES_PASSWORD=change-me

# Initial admin account (created on first start if no users exist)
ADMIN_USERNAME=andrew
ADMIN_PASSWORD=change-me-too

# Claude API (leave empty to run without AI features — the tracker degrades gracefully)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Static MCP bootstrap token (optional; prefer DB tokens created via
# `docker compose exec app python -m app.cli create-token <name> --kind mcp`)
MCP_TOKEN=

APP_ENV=prod
