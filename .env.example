# Copy to .env and fill in. Never commit .env.

# PostgreSQL superuser password for the compose stack (required)
POSTGRES_PASSWORD=change-me

# Initial admin account (created on first start if no users exist)
ADMIN_USERNAME=andrew
ADMIN_PASSWORD=change-me-too

# LLM provider: "anthropic" (Claude API) or "openai" (any OpenAI-compatible
# /v1/chat/completions endpoint, e.g. a self-hosted model).
# Leave keys empty to run without AI — the tracker degrades gracefully.
LLM_PROVIDER=anthropic
LLM_TIMEOUT_SECONDS=15

# provider=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# provider=openai (self-hosted). Base URL up to and including /v1.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Static MCP bootstrap token (optional; prefer DB tokens created via
# `docker compose exec app python -m app.cli create-token <name> --kind mcp`)
MCP_TOKEN=

# Распознавание речи: self-hosted Whisper с OpenAI-совместимым
# /v1/audio/transcriptions (ADR-0007). Пусто = диктовка выключена, трекер
# работает как обычно. Внутрикластерное имя сервиса из compose недостижимо —
# нужен адрес, видимый контейнеру (NodePort через host.docker.internal).
# Пример: http://host.docker.internal:30558
WHISPER_BASE_URL=
WHISPER_LANGUAGE=ru
WHISPER_TIMEOUT_SECONDS=60
WHISPER_MAX_AUDIO_MB=10

# Адрес HTTPS-сайта в LAN (ADR-0006). Нужен для диктовки: браузер не даёт
# доступ к микрофону на странице, открытой по HTTP. Порт должен совпадать с
# опубликованным у сервиса caddy. Пример: https://192.168.1.55:27183
TT_HTTPS_ADDR=https://localhost

APP_ENV=prod

# Mark the session cookie Secure. Set to true together with TT_HTTPS_ADDR
# (ADR-0006): с true UI логинится только по HTTPS, а HTTP-вход остаётся
# рабочим для MCP-агентов — они авторизуются Bearer-токеном, а не кукой.
COOKIE_SECURE=false

# IANA timezone (e.g. Europe/Moscow) used for "today" boundaries in the daily
# summary. Binds to the backend `timezone` setting via the TIMEZONE env var.
TIMEZONE=UTC
